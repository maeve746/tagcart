# Copy this file to .env and provide server-side Supabase credentials.
# Never expose SUPABASE_SECRET_KEY in Vite variables or browser code.
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_SECRET_KEY=your-server-only-secret-key

# Pydantic Settings expects a JSON array when overriding this value.
CORS_ORIGINS=["http://localhost:5173","http://127.0.0.1:5173"]

# Generate with: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# Required before any marketplace token can be persisted.
MARKETPLACE_TOKEN_ENCRYPTION_KEY=
MARKETPLACE_HTTP_TIMEOUT_SECONDS=10
# College/demo mode. Mock mode performs no Amazon or Myntra HTTP requests.
# Change to production only for approved connection flows; live listing
# submission remains intentionally unimplemented in every mode.
MARKETPLACE_MODE=mock

# Amazon SP-API / Login with Amazon. All values come from your approved SP-API app.
AMAZON_SPAPI_APP_ID=
AMAZON_LWA_CLIENT_ID=
AMAZON_LWA_CLIENT_SECRET=
AMAZON_OAUTH_REDIRECT_URI=http://127.0.0.1:8000/api/marketplaces/amazon/callback
# Use the Seller Central base URL for the seller's Amazon region; do not include a path.
AMAZON_SELLER_CENTRAL_URL=
# Draft apps require version=beta during seller authorization.
AMAZON_APP_IS_DRAFT=true

# Myntra supplies these during approved PPMP/Omni partner onboarding.
MYNTRA_API_BASE_URL=
MYNTRA_MERCHANT_ID=
MYNTRA_SECRET_KEY=
